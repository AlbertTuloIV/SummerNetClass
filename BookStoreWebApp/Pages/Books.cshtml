@page
@model BookStoreWebApp.Pages.BooksModel
@{
    ViewData["Title"] = "Books";
}

<h1>Books</h1>

<p>
    <a asp-page="NewBook" class="btn btn-primary">Add New Book</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Author</th>
            <th>Pages</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model.Books)
        {
            <tr>
                <td>@book.Id</td>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.Pages</td>
                <td>@book.Price.ToString("C")</td>
                <td>
                    <a asp-page="EditBook" asp-route-id="@book.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-page="DeleteBook" asp-route-id="@book.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
