@page "{id:int}"
@model BookStoreWebApp.Pages.DeleteBookModel
@{
    ViewData["Title"] = "Delete Book";
}

<h1>Delete Book</h1>

<div class="alert alert-danger">
    <p>Are you sure you want to delete this book?</p>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Book.Title</h5>
        <p class="card-text"><strong>Author:</strong> @Model.Book.Author</p>
        <p class="card-text"><strong>Pages:</strong> @Model.Book.Pages</p>
        <p class="card-text"><strong>Price:</strong> @Model.Book.Price.ToString("C")</p>
    </div>
</div>

<form method="post" class="mt-3">
    <input type="hidden" name="Id" value="@Model.Book.Id">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Books" class="btn btn-secondary">Cancel</a>
</form>
